# Скопируй этот файл в .env и заполни обязательные переменные (без значения,
# помечены "ОБЯЗАТЕЛЬНО"): cp .env.example .env
#
# Остальные переменные — необязательные: показано значение по умолчанию,
# которое применится, если строку не менять или удалить. Порядок блоков
# совпадает с порядком полей в core/config.py::Settings — так проще
# свериться, что переменная действительно читается приложением.

# --- Postgres ---
# ОБЯЗАТЕЛЬНО
POSTGRES_USER=
# ОБЯЗАТЕЛЬНО
POSTGRES_PASSWORD=
# ОБЯЗАТЕЛЬНО
POSTGRES_DB=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Пусто -> подключение без пароля.
REDIS_PASSWORD=

# --- Celery (core/celery_app.py) ---
# Отдельные номера БД Redis под очередь/результаты — не совпадают с REDIS_DB
# (та по умолчанию занята под дедуп-хэши BP-1).
CELERY_BROKER_DB=1
CELERY_RESULT_BACKEND_DB=2

# --- Пути для хранения данных BP-1 ---
BP1_DATA_ROOT=./src/bp1/data

# --- Mail (SMTP для алертов BP-5) ---
# ОБЯЗАТЕЛЬНО
MAIL_USERNAME=
# ОБЯЗАТЕЛЬНО
MAIL_PASSWORD=
# ОБЯЗАТЕЛЬНО
MAIL_FROM=
MAIL_FROM_NAME=Kodik Alerts
MAIL_PORT=465
# ОБЯЗАТЕЛЬНО
MAIL_SERVER=
MAIL_STARTTLS=False
MAIL_SSL_TLS=True
MAIL_USE_CREDENTIALS=True
MAIL_VALIDATE_CERTS=True

# --- Telegram (доставка алертов BP-5) ---
# ОБЯЗАТЕЛЬНО — токен бота, его нужно сначала завести.
TELEGRAM_BOT_TOKEN=
# ОБЯЗАТЕЛЬНО — числовой chat_id, куда падают тестовые/песочные алерты.
TEST_TG=

# --- Alerting (флаг адресата, НЕ флаг включения отправки) ---
# Отправка (SMTP/Telegram) идёт ВСЕГДА при запуске BP-5, этот флаг только
# выбирает, кому: False -> письмо/тг уходят на TEST_EMAIL/TEST_TG (песочница),
# True -> реальному получателю (email/telegram_id из routing_rule).
TRUE_ALERTING=False
# ОБЯЗАТЕЛЬНО — почта песочницы для TRUE_ALERTING=False.
TEST_EMAIL=

# --- Сбор данных (флаг реализации этапа 1, НЕ флаг включения сбора) ---
# False -> заглушка (core/scripts/stages/bp1_stub.py, синтетические
# новости, без сети и LLM) — дешёвая сквозная проверка конвейера.
# True -> настоящий адаптивный сбор по заведённым задачам сбора
# (search_task): требует живого Redis и сетевого доступа к источникам.
TRUE_PARSING=False

# --- FastAPI ---
API_HOST=127.0.0.1
# ОБЯЗАТЕЛЬНО — локальный порт HTTP API и FastAdmin.
API_PORT=8000
APP_TITLE=Конкурентная разведка
DESCRIPTION=API управлния проектом конкурентная разведка

# --- CORS ---
# Список разрешённых origin через запятую.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- JWT (авторизация API) ---
# ОБЯЗАТЕЛЬНО — длинная случайная строка, напр. `openssl rand -hex 32`.
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=60

# --- Сброс пароля ---
PASSWORD_RESET_CODE_EXPIRE_MINUTES=10

# --- BP-3 (LLM-категоризация через OpenRouter, поиск источников Tavily) ---
# ОБЯЗАТЕЛЬНО — https://openrouter.ai/keys
OPENROUTER_API_KEY=
# ОБЯЗАТЕЛЬНО — https://app.tavily.com/sign-in
TAVILY_API_KEY=
BP3_MODEL=openai/gpt-4o
# Число результатов и глубина поиска влияют на стоимость каждого прогона.
BP3_SEARCH_MAX_RESULTS=2
# Допустимые значения: basic, advanced, fast, ultra-fast.
# advanced расходует больше API credits; basic — исходный режим проекта.
BP3_SEARCH_DEPTH=basic
BP3_SEARCH_TIME_RANGE=week
# Совместимый альтернативный адрес: https://api.kodikrouter.ru/v1
BP3_LLM_BASE_URL=https://openrouter.ai/api/v1
BP3_LLM_TEMPERATURE=0
BP3_LLM_MAX_TOKENS=4096

# --- BP-6 AI-ассистент (генерация action_item через DeepSeek) ---
# ОБЯЗАТЕЛЬНО
DEEPSEEK_TOKEN=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- BP-1 Adaptive: LLM-анализ HTML (селекторы, стратегии обхода) ---
# Отдельный доступ от BP-3/BP-6 — три независимых LLM-провайдера в проекте.
# Опционально: без ключа адаптивный парсер работает на эвристике (fallback).
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini

# --- BP-1 Adaptive: объём и глубина сбора ---
# Сколько новостей брать с источника за один проход пагинации.
BP1_MAX_NEWS_PER_SOURCE=3
# Минимальная длина текста, при которой извлечение статьи считается успешным.
BP1_MIN_ARTICLE_TEXT_LENGTH=100
# Минимальная длина текста, при которой он считается ПОЛНЫМ (короче — докачка).
BP1_MIN_FULL_ARTICLE_TEXT_LENGTH=300
# Максимум попыток докачать обрезанный хвост статьи.
BP1_MAX_TAIL_FETCH_ATTEMPTS=3
# Минимальная длина HTML, при которой стратегия обхода считается успешной.
BP1_MIN_CONTENT_LENGTH=300

# --- BP-1 Adaptive: сетевые ограничения ---
# Таймаут парсинга (мс) — общий для классического BP-1 и AdaptiveRunner.
BP1_PARSE_TIMEOUT_MS=60000
# Максимум одновременных задач сбора.
BP1_MAX_CONCURRENT_TASKS=5
# Таймаут (сек) на извлечение полного текста одной статьи.
BP1_ARTICLE_FETCH_TIMEOUT_SECONDS=20.0
# Максимум одновременно докачиваемых статей (глубокий фетч).
BP1_MAX_CONCURRENT_FETCHES=3

# --- BP-1 Adaptive: время жизни кэшей (сек) ---
# Профиль адаптера (селекторы источника) — дорогой промах, переобучение.
BP1_ADAPTER_TTL_SECONDS=604800
# Классификация источника (тип сайта, антибот, CAPTCHA).
BP1_CLASSIFICATION_TTL_SECONDS=604800
# Текст статьи — дешёвый промах, просто повторный запрос.
BP1_ARTICLE_TEXT_TTL_SECONDS=604800

# --- BP-1 Adaptive: режим прогона AdaptiveRunner ---
# adaptive | hybrid | fallback.
BP1_ADAPTIVE_MODE=adaptive
# Headless-режим браузера при обходе источников.
BP1_HEADLESS=True

# --- Circuit breaker для источников (BP-1 Adaptive) ---
# Время временной блокировки источника в Redis после полного отказа всех
# стратегий обхода, в секундах.
SOURCE_CIRCUIT_TTL_SECONDS=86400
# Число подряд идущих полных отказов, после которого источник отключается
# в БД (is_active=False).
SOURCE_DISABLE_THRESHOLD=3

# --- BP-7 (агент расширения источников) ---
# Порог score, выше которого source_candidate переносится в source.
SOURCE_CANDIDATE_SCORE_THRESHOLD=0.5

# --- Админка (FastAdmin, http://localhost:8001/admin) ---
# Отдельный сервер/контейнер не нужен: админка живёт в том же uvicorn-процессе,
# что и API. Подробности — в api/ADMIN_README.md.
ADMIN_SITE_NAME=Кодик — админка
ADMIN_LANGUAGE=ru
# Пустой -> используется JWT_SECRET_KEY.
ADMIN_SECRET_KEY=
# ОБЯЗАТЕЛЬНО False для локального http, иначе вход не сработает.
# На проде за HTTPS — True.
ADMIN_SESSION_COOKIE_SECURE=False

# =============================================================================
# Только для docker-compose — приложение эти переменные не читает
# =============================================================================

# --- Redis Commander (веб-интерфейс к Redis, docker-compose.yml) ---
REDIS_COMMANDER_PORT=8081
