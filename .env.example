# --- PostgreSQL ---
POSTGRES_USER=postgres_user # заменить в проде
POSTGRES_PASSWORD=postgres_password # заменить в проде
POSTGRES_DB=kodik_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=redis_password # заменить в проде

# --- Настройки алёртов ---
TRUE_ALERTING=False # выключено: тестовые; включено: получатели из routing_rule
TEST_EMAIL=alerts@example.com # тестовый получатель
TEST_TG=123456789 # ID тестового Telegram-чата
MAIL_USERNAME=alerts@example.com # логин SMTP
MAIL_PASSWORD=mail_password # заменить в проде
MAIL_FROM=alerts@example.com
MAIL_FROM_NAME=Kodik Alerts
MAIL_SERVER=smtp.example.com # заменить в проде
MAIL_PORT=465
MAIL_STARTTLS=False
MAIL_SSL_TLS=True
MAIL_USE_CREDENTIALS=True
MAIL_VALIDATE_CERTS=True
TELEGRAM_BOT_TOKEN=123456:telegram_bot_token # заменить в проде

# --- Celery (core/celery_app.py) ---
CELERY_BROKER_DB=1 # Redis-база очереди задач Celery
CELERY_RESULT_BACKEND_DB=2 # Redis-база результатов задач Celery
CELERY_WORKER_CONCURRENCY=2 # задачи BP2--BP7 и служебные задачи
CELERY_BP1_WORKER_CONCURRENCY=1 # задачи BP1 с браузером
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=900 # мягкий лимит задачи
CELERY_TASK_TIME_LIMIT_SECONDS=960 # жёсткий лимит задачи
CELERY_TASK_MAX_RETRIES=3
CELERY_TASK_DEFAULT_RETRY_DELAY_SECONDS=60
CELERY_TASK_RETRY_BACKOFF_MAX_SECONDS=600

# --- Расписание пайплайна ---
PIPELINE_SCHEDULE_ENABLED=False # включать после проверки воркеров
#минута час день-месяца месяц день-недели
#  0      8   *           *     *
PIPELINE_SCHEDULE_CRON=0 8 * * * # cron из 5 полей: ежедневно в 08:00; */15 * * * * — каждые 15 минут
PIPELINE_SCHEDULE_TIMEZONE=Europe/Moscow # часовой пояс IANA
PIPELINE_SCHEDULE_POLL_SECONDS=60 # интервал опроса Beat
PIPELINE_RUN_STALE_TIMEOUT_SECONDS=1800 # тайм-аут watchdog

# --- Flower ---
FLOWER_BASIC_AUTH=admin:admin # заменить в проде
FLOWER_PORT=5555

# --- Технические логи (Grafana + Loki) ---
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me # заменить до внешнего развёртывания
GRAFANA_URL=http://localhost:3001

# --- FastAPI ---
API_HOST=127.0.0.1
API_PORT=8000
APP_TITLE=Конкурентная разведка
DESCRIPTION=API управления проектом конкурентной разведки
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JWT_SECRET_KEY=dev-only-change-this-jwt-secret-key-2026 # заменить в проде
JWT_EXPIRE_MINUTES=60
PASSWORD_RESET_CODE_EXPIRE_MINUTES=10 # срок действия кода сброса, минут
ADMIN_SITE_NAME=Кодик — админка
ADMIN_LANGUAGE=ru
ADMIN_SECRET_KEY= # пусто: используется JWT_SECRET_KEY
ADMIN_SESSION_COOKIE_SECURE=False # включить при HTTPS

# --- BP-1 ---
TRUE_PARSING=False # выключено: заглушка; включено: реальный сбор источников
BP1_DATA_ROOT=./src/bp1/data
SX_ORG_API_KEY= # необязательный ключ провайдера прокси (sx.org) для RPA-сбора
SX_ORG_BASE_URL=https://api.sx.org
BP1_PROXY_COUNTRY= # код страны для подбора прокси (например, RU); пусто — без фильтра
BP1_PROXY_POOL_SIZE=20
BP1_PROXY_MIN_BALANCE=1.0 # порог баланса: выше — свои порты, ниже — свободные прокси
BP1_PROXY_POOL_TTL_SECONDS=1800
BP1_PROXY_COOLDOWN_SECONDS=1800 # остывание адреса, заблокированного источником
BP1_RPA_REQUEST_DELAY_SECONDS=2.0 # мин. пауза между запросами к одному хосту (RPA)
LLM_API_KEY= # необязательный ключ LLM адаптивного парсера
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
BP1_MAX_NEWS_PER_SOURCE=3 # новостей с одного источника
BP1_MIN_ARTICLE_TEXT_LENGTH=100 # минимальная длина статьи
BP1_MIN_FULL_ARTICLE_TEXT_LENGTH=300 # порог полного текста
BP1_MAX_TAIL_FETCH_ATTEMPTS=3 # попыток докачать хвост
BP1_MIN_CONTENT_LENGTH=300 # минимальная длина HTML
BP1_PARSE_TIMEOUT_MS=60000 # тайм-аут парсера, мс
BP1_MAX_CONCURRENT_TASKS=5 # параллельных задач по источникам
BP1_ARTICLE_FETCH_TIMEOUT_SECONDS=20.0 # тайм-аут одной статьи
BP1_MAX_CONCURRENT_FETCHES=3 # параллельных загрузок статей
BP1_ADAPTER_TTL_SECONDS=604800 # кэш адаптера, секунд
BP1_CLASSIFICATION_TTL_SECONDS=604800 # кэш классификации, секунд
BP1_ARTICLE_TEXT_TTL_SECONDS=604800 # кэш статьи, секунд
BP1_FEED_CACHE_TTL_SECONDS=604800 # кэш обнаружения RSS/sitemap, секунд
BP1_FEED_ITEMS_CACHE_TTL_SECONDS=3600 # кэш распарсенных материалов фида, секунд
BP1_FEED_FAIL_THRESHOLD=2 # подряд отказов фида до сброса кэша обнаружения
BP1_ADAPTIVE_MODE=adaptive # режим: adaptive | hybrid | fallback
BP1_HEADLESS=True # браузер без интерфейса
SOURCE_CIRCUIT_TTL_SECONDS=86400 # временная блокировка источника, секунд
SOURCE_DISABLE_THRESHOLD=3 # отказов до отключения источника

# --- BP-3 ---
OPENROUTER_API_KEY=change-me # заменить в проде
TAVILY_API_KEY=change-me # заменить в проде
BP3_MODEL=openai/gpt-4o
BP3_SEARCH_MAX_RESULTS=2
BP3_SEARCH_DEPTH=basic
BP3_SEARCH_TIME_RANGE=week
BP3_LLM_BASE_URL=https://openrouter.ai/api/v1
BP3_LLM_TEMPERATURE=0
BP3_LLM_MAX_TOKENS=4096

# --- BP-6 ---
DEEPSEEK_TOKEN=change-me # заменить в проде
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- BP-7 ---
SOURCE_CANDIDATE_SCORE_THRESHOLD=0.5

# --- Docker Compose ---
FRONTEND_PORT=3000
REDIS_COMMANDER_PORT=8081
