# Скопируй этот файл в .env и подставь свои значения
# cp .env.example .env

# --- Postgres ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_DB=kodik_db
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# --- Redis ---
REDIS_PASSWORD=password
REDIS_PORT=6379
REDIS_HOST=localhost

# --- Redis Commander (веб-интерфейс к Redis) ---
REDIS_COMMANDER_PORT=8081

# --- Celery (общий каркас в core/celery_app.py) ---
# Отдельные номера БД Redis под очередь/результаты — не REDIS_DB
# (та занята под дедуп-хэши BP-1).
CELERY_BROKER_DB=1
CELERY_RESULT_BACKEND_DB=2
# Порт веб-панели Flower (celery -A core.celery_app flower)
FLOWER_PORT=5555

# --- Mail (SMTP для алертов BP-5) ---
MAIL_USERNAME=changeme@example.com
MAIL_PASSWORD=changeme
MAIL_FROM=changeme@example.com
MAIL_PORT=465
MAIL_SERVER=smtp.example.com
MAIL_FROM_NAME=Kodik Alerts
MAIL_STARTTLS=False
MAIL_SSL_TLS=True
MAIL_USE_CREDENTIALS=True
MAIL_VALIDATE_CERTS=True

# --- Alerting (флаг адресата, НЕ флаг включения отправки) ---
# Отправка (SMTP/Telegram) идёт ВСЕГДА при запуске BP-5, этот флаг только
# выбирает, кому: False -> письмо/тг уходят на TEST_EMAIL/TEST_TG (песочница),
# True -> реальному получателю (email/telegram_id из routing_rule).
TRUE_ALERTING=False

TEST_EMAIL=test@example.com  # тут можете для теста свою почту указать
TELEGRAM_BOT_TOKEN=changeme  # тут айдишник бота, его нужно сначала завести.
TEST_TG=000000000            # тут можете для теста свой тг айди указать

# --- JWT (авторизация API) ---
JWT_SECRET_KEY=changeme
JWT_EXPIRE_MINUTES=60

# --- LLM section ---
# BP-6. Строго агент DeepSeek, тестовая генерация таблицы action_item с задачами для менеджеров
# (можно будет удалять когда будет готов ральный агент для генерации задач)
DEEPSEEK_TOKEN=changeme

# BP-1 Adaptive: анализ структуры HTML, выбор стратегии обхода
# См. src/bp1/adaptive/llm.py и README пакета. Без ключей адаптивный парсер
# работает на эвристике (fallback), поэтому секция опциональна.
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=changeme
# LLM_BASE_URL пока не используется кодом litellm.acompletion() в llm.py
# (передаётся только model) — оставлено для документации на будущее.
LLM_BASE_URL=
OPENAI_API_KEY=changeme
# Если LLM_MODEL со схемой провайдера (например deepseek/deepseek-chat),
# litellm берёт ключ из ЕГО СОБСТВЕННОЙ переменной, а не из LLM_API_KEY —
# для DeepSeek это DEEPSEEK_API_KEY.
DEEPSEEK_API_KEY=changeme

# BP-3
# OpenRouter API Key (получите на https://openrouter.ai/keys)
OPENROUTER_API_KEY=changeme
# KodikRouter API Key (получите на https://kodikrouter.ru/keys) — сейчас не используется кодом,
# оставлен на случай возврата к api.kodikrouter.ru
KODIK_API_KEY=changeme
# TAVILY API Key (получите на https://app.tavily.com/sign-in)
TAVILY_API_KEY=changeme
# Модель LLM для BP-3 (необязательно, дефолт — openai/gpt-4o)
# BP3_MODEL=openai/gpt-4o

# --- BP-7 (агент расширения источников) ---
# Порог score, выше которого source_candidate переносится в source
SOURCE_CANDIDATE_SCORE_THRESHOLD=0.5

# --- Админка (FastAdmin, http://localhost:8000/admin) ---
# Отдельный сервер/контейнер НЕ нужен: админка живёт в том же uvicorn-процессе,
# что и API. Подробности — в api/ADMIN_README.md.
ADMIN_SITE_NAME=Кодик — админка
ADMIN_LANGUAGE=ru
# Пустой -> используется JWT_SECRET_KEY
ADMIN_SECRET_KEY=
# ОБЯЗАТЕЛЬНО False для локального http, иначе вход не сработает.
# На проде за HTTPS — True.
ADMIN_SESSION_COOKIE_SECURE=False
