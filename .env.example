# Скопируй этот файл в .env и подставь свои значения
# cp .env.example .env

# --- Postgres ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_DB=kodik_db
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# --- Redis ---
REDIS_PASSWORD=password
REDIS_PORT=6379
REDIS_HOST=localhost

# --- pgAdmin (веб-интерфейс к Postgres) ---
PGADMIN_EMAIL=admin@main.ru
PGADMIN_PASSWORD=password
PGADMIN_PORT=5050

# --- Redis Commander (веб-интерфейс к Redis) ---
REDIS_COMMANDER_PORT=8081

# --- Mail (SMTP для алертов BP-5) ---
MAIL_USERNAME=changeme@example.com
MAIL_PASSWORD=changeme
MAIL_FROM=changeme@example.com
MAIL_PORT=465
MAIL_SERVER=smtp.example.com
MAIL_FROM_NAME=Kodik Alerts
MAIL_STARTTLS=False
MAIL_SSL_TLS=True
MAIL_USE_CREDENTIALS=True
MAIL_VALIDATE_CERTS=True

# --- Alerting (флаг реальной отправки предупреждений) ---
# Если стоит False то и письмо и тг будут использоваться TEST_EMAIL, TEST_TG
TRUE_ALERTING=False

TEST_EMAIL=test@example.com
TELEGRAM_BOT_TOKEN=changeme
TEST_TG=000000000

# --- JWT (авторизация API) ---
JWT_SECRET_KEY=changeme
JWT_EXPIRE_MINUTES=60

# --- AI-ассистент (DeepSeek, генерация action_item из алертов BP-5) ---
DEEPSEEK_TOKEN=changeme

# --- BP-7 (агент расширения источников) ---
# Порог score, выше которого source_candidate переносится в source
SOURCE_CANDIDATE_SCORE_THRESHOLD=0.5

# --- Админка (FastAdmin, http://localhost:8000/admin) ---
# Отдельный сервер/контейнер НЕ нужен: админка живёт в том же uvicorn-процессе,
# что и API. Подробности — в api/ADMIN_README.md.
ADMIN_SITE_NAME=Кодик — админка
ADMIN_LANGUAGE=ru
# Пустой -> используется JWT_SECRET_KEY
ADMIN_SECRET_KEY=
# ОБЯЗАТЕЛЬНО False для локального http, иначе вход не сработает.
# На проде за HTTPS — True.
ADMIN_SESSION_COOKIE_SECURE=False
